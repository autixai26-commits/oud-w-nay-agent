# ملفات لا لزوم لها داخل صورة الإنتاج

__pycache__/
*.py[cod]
.venv/
venv/

# سكربتات التحقق تُشغَّل محلياً لا في الإنتاج
verify_*.py

# أدوات ضغط الصور تُشغَّل عند تحديث الصور فقط
compress_images.py
compress_menu.py

# أصول صور المنيو: الجاهزة في assets/menu/<الفئة>/ هي ما يُرسل.
# ملاحظة: لا يُضاف هنا أي نمط يطابق assets/menu/<الفئة>/ — تلك الصور
# **يجب** أن تدخل الصورة، وغيابها يسقط زر المنيو صامتاً.
assets/menu/original/

# الأسرار لا تدخل الصورة إطلاقاً — Render يمرّرها كمتغيّرات بيئة
.env
*.env
