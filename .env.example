# ============================================================
#  عود وناي — ملف المتغيرات
#  انسخ هذا الملف باسم  .env  وعبّي القيم.
#  ملف .env ما بينرفع على گِت أبداً (محمي بـ .gitignore).
#  ولا تنشر أي قيمة من هون بأي مكان.
# ============================================================

# --- تيليجرام ---
# التوكن اللي بيعطيك ياه @BotFather بعد /newbot
TELEGRAM_BOT_TOKEN=

# --- OpenRouter (الأسئلة الحرة) ---
# المفتاح من openrouter.ai/keys — بيبلّش بـ sk-or-v1
OPENROUTER_API_KEY=
# اسم الموديل. غيّره من هون بدون ما تلمس الكود.
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# --- ElevenLabs (تحويل الصوت لنص + تحويل النص لصوت) ---
# نفس المفتاح للاثنين.
ELEVENLABS_API_KEY=
# معرّف الصوت. خذه من صفحة الصوت بحسابك (Voice ID).
ELEVENLABS_VOICE_ID=

# --- Supabase (قاعدة البيانات) ---
# من Project Settings ← API
SUPABASE_URL=
# استخدم مفتاح  service_role  مش  anon.
SUPABASE_SERVICE_KEY=

# --- أسرار الأدمن ---
# كلمة سر لمرة وحدة: الأدمن بيبعتها للبوت بأمر /admin عشان يتسجّل.
# اختار نص عشوائي طويل، وغيّره بعد ما يتسجّل الأدمنية.
ADMIN_SETUP_SECRET=
# كلمة سر صفحة لوحة العرض admin.html
ADMIN_DASHBOARD_PASSWORD=

# --- الروابط ---
# رابط الموقع على Netlify (بدون / بالآخر) — مثال: https://oudwnay.netlify.app
PUBLIC_WEB_URL=
# رابط الباك إند على Render (بدون / بالآخر) — مثال: https://oud-w-nay.onrender.com
BACKEND_URL=

# --- معلومات ثابتة ---
RESTAURANT_PHONE=0770800120
# المنطقة الزمنية — لا تغيّرها إلا إذا انتقل المطعم لبلد ثاني.
TIMEZONE=Asia/Amman

# --- اختيارية: لها قيم افتراضية سليمة، لا تلمسها إلا لسبب ---
# نموذج ElevenLabs لتحويل الصوت لنص. الافتراضي scribe_v1.
# ELEVENLABS_STT_MODEL=scribe_v1
# مسار ffmpeg. بالإنتاج مركّب داخل الصورة فما بتحتاجه.
# بتحتاجه بس لو بتشغّل محلياً وffmpeg مش بالـPATH.
# FFMPEG_BIN=

# --- الاختبار فقط ---
# 1 = الأوقات الحقيقية (دقائق). 60 = كل دقيقة بتصير ثانية، للاختبار السريع.
# خليه 1 دايماً بالإنتاج.
TEST_TIME_SCALE=1
